APP_ENV=development
API_PORT=8000

LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://replace-with-your-api-base-url/v1
LLM_MODEL=replace-with-your-model-name

POSTGRES_USER=agent
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=site_selection
POSTGRES_PORT=5432

REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_PORT=6379

SITE_SELECTION_QUEUE_NAME=site-selection
SITE_SELECTION_JOB_TIMEOUT_SECONDS=180
SITE_SELECTION_JOB_RESULT_TTL_SECONDS=3600
SITE_SELECTION_JOB_FAILURE_TTL_SECONDS=86400
SITE_SELECTION_RUN_TTL_SECONDS=86400
SITE_SELECTION_IDEMPOTENCY_TTL_SECONDS=86400
SITE_SELECTION_POI_CACHE_TTL_SECONDS=3600
SITE_SELECTION_LAND_USE_CACHE_TTL_SECONDS=3600
SITE_SELECTION_DISCOVERY_SNAPSHOT_TTL_SECONDS=7200
SITE_SELECTION_EVENT_TTL_SECONDS=86400
SITE_SELECTION_SUPERVISOR_ENABLED=true
SITE_SELECTION_SUPERVISOR_SESSION_TTL_SECONDS=7200
SITE_SELECTION_SUPERVISOR_LOCK_TTL_SECONDS=120
SITE_SELECTION_SCENARIO_SESSION_TTL_SECONDS=86400

# auto | amap | fixture
SITE_SELECTION_REGION_PROVIDER=auto
SITE_SELECTION_REGION_TIMEOUT_SECONDS=8
SITE_SELECTION_AMAP_DISTRICT_ENDPOINT=https://restapi.amap.com/v3/config/district

# 可选：LLM 只提取约束提案；确定性代码负责校验、确认和执行
SITE_SELECTION_CONVERSATION_LLM_ENABLED=false
SITE_SELECTION_CONVERSATION_TIMEOUT_SECONDS=12
SITE_SELECTION_CONVERSATION_MAX_RETRIES=0

# fixture | auto | amap | overpass
SITE_SELECTION_POI_PROVIDER=auto
AMAP_API_KEY=
SITE_SELECTION_POI_FALLBACK_ENABLED=true
SITE_SELECTION_POI_PERSIST_ENABLED=true
SITE_SELECTION_POI_TIMEOUT_SECONDS=15
SITE_SELECTION_POI_REQUESTS_PER_SECOND=1
# Docker 中使用宿主机代理示例：http://host.docker.internal:7897
SITE_SELECTION_POI_PROXY_URL=
SITE_SELECTION_AMAP_MAX_PAGES_PER_SEARCH=2
SITE_SELECTION_AMAP_MAX_CATEGORIES_PER_QUERY=3
SITE_SELECTION_OVERPASS_MAX_CATEGORIES_PER_QUERY=3
SITE_SELECTION_POI_MAX_ATTEMPTS=2
SITE_SELECTION_POI_FAILURE_THRESHOLD=12
SITE_SELECTION_POI_RECOVERY_SECONDS=30
SITE_SELECTION_POI_RETRY_BASE_SECONDS=2
SITE_SELECTION_POI_RETRY_MAX_SECONDS=8
SITE_SELECTION_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
SITE_SELECTION_LAND_USE_PROVIDER=auto
SITE_SELECTION_LAND_USE_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
SITE_SELECTION_LAND_USE_TIMEOUT_SECONDS=15
SITE_SELECTION_LAND_USE_MAX_FEATURES=500
SITE_SELECTION_LAND_USE_CACHE_VERSION=osm-land-use-v1
# Set after importing a reviewed official layer with scripts/import_authoritative_land_use.py
SITE_SELECTION_AUTHORITATIVE_LAND_LAYER_ID=
SITE_SELECTION_POI_USER_AGENT=ai-agent-learning-site-selection/1.0

# 可选 LLM 证据解释不能阻塞确定性分析过久
SITE_SELECTION_EXPLANATION_TIMEOUT_SECONDS=15
SITE_SELECTION_EXPLANATION_MAX_RETRIES=0
